{
  "$schema": "https://arcana.otnelhq.com/schema/config.json",
  "provider": {
    "arcana-proxy": {
      "name": "Arcana Proxy",
      "npm": "@ai-sdk/openai-compatible",
      "api": "https://proxy.arcana.otnelhq.com/v1",
      "env": ["ARCANA_PROXY_KEY"]
    },
    "nous-portal": {
      "name": "Nous Portal",
      "npm": "@ai-sdk/openai-compatible",
      "api": "https://portal-api.nousresearch.com/v1",
      "env": ["NOUS_PORTAL_API_KEY"],
      "models": {
        "nous-hermes-3-llama-3.1-70b": {
          "name": "Nous Hermes 3 70B",
          "tool_call": true,
          "limit": { "context": 131072, "output": 4096 }
        }
      }
    },
    "mimo": {
      "name": "MiMo (Xiaomi)",
      "npm": "@ai-sdk/openai-compatible",
      "api": "https://api.xiaomimimo.com/v1",
      "env": ["MIMO_API_KEY"],
      "models": {
        "mimo-7b": {
          "name": "MiMo 7B",
          "tool_call": true,
          "limit": { "context": 32768, "output": 4096 }
        }
      }
    },
    "cloudflare-ai-gateway": {
      "name": "Cloudflare AI Gateway",
      "npm": "@ai-sdk/openai-compatible",
      "api": "https://proxy.arcana.otnelhq.com/v1",
      "env": ["ARCANA_PROXY_KEY"],
      "models": {
        "workers-ai/@cf/meta/llama-3.1-8b-instruct": {
          "name": "Workers AI Llama 3.1 8B via AI Gateway",
          "tool_call": true,
          "limit": { "context": 32768, "output": 4096 }
        }
      }
    },
    "cloudflare-workers-ai": {
      "name": "Cloudflare Workers AI",
      "npm": "@ai-sdk/openai-compatible",
      "api": "https://proxy.arcana.otnelhq.com/v1",
      "env": ["ARCANA_PROXY_KEY"],
      "models": {
        "@cf/meta/llama-3.1-8b-instruct": {
          "name": "Workers AI Llama 3.1 8B",
          "tool_call": true,
          "limit": { "context": 32768, "output": 4096 }
        }
      }
    }
  }
}
