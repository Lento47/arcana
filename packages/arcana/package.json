{
  "name": "arcana-ai",
  "version": "0.3.67",
  "description": "Governed autonomy runtime, operator console, and proof system for AI agents",
  "type": "module",
  "bin": {
    "arcana": "./bin/arcana"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./proof": "./src/proof/index.ts",
    "./cli/cmd/*": "./src/cli/cmd/*.ts"
  },
  "homepage": "https://arcana.otnelhq.com/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lento47/arcana.git",
    "directory": "packages/arcana"
  },
  "bugs": {
    "url": "https://github.com/Lento47/arcana/issues"
  },
  "keywords": [
    "ai-agents",
    "governance",
    "autonomous-agents",
    "policy-enforcement",
    "provenance",
    "tui"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@arcana/core": "workspace:*",
    "@arcana/memory": "workspace:*",
    "@arcana/cron": "workspace:*",
    "@arcana/gateway": "workspace:*",
    "@arcana/ml": "workspace:*",
    "@modelcontextprotocol/sdk": "1.29.0",
    "ai": "catalog:",
    "@ai-sdk/openai": "catalog:",
    "@ai-sdk/anthropic": "catalog:",
    "@ai-sdk/google": "catalog:",
    "@ai-sdk/openai-compatible": "catalog:",
    "zod": "catalog:",
    "yargs": "17.7.2",
    "gray-matter": "catalog:"
  },
  "devDependencies": {
    "@types/yargs": "17.0.33",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
