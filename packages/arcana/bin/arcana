#!/usr/bin/env sh
set -e

# Resolve repo root from script location (packages/arcana/bin/arcana → repo root)
SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)"
REPO_ROOT="$(CDPATH='' cd -- "$SCRIPT_DIR/../.." && pwd -P)"
ARCANA_HOME="${ARCANA_HOME:-$HOME/.arcana}"
# bridge-config.json is the canonical name (was opencode-config.json).
CONFIG="$ARCANA_HOME/cache/bridge-config.json"
LEGACY_CONFIG="$ARCANA_HOME/cache/opencode-config.json"

# Backward compat: if bridge-config doesn't exist but the legacy name does, use it.
if [ ! -f "$CONFIG" ] && [ -f "$LEGACY_CONFIG" ]; then
  CONFIG="$LEGACY_CONFIG"
fi

# Generate bridge config once if missing (sub-50ms)
if [ ! -f "$CONFIG" ]; then
  mkdir -p "$ARCANA_HOME/cache" 2>/dev/null || true
  SKILLS_DIRS=""
  if [ -d "$REPO_ROOT/skills" ]; then
    SKILLS_DIRS="\"$REPO_ROOT/skills\""
  fi
  if [ -d "$ARCANA_HOME/skills" ]; then
    if [ -n "$SKILLS_DIRS" ]; then
      SKILLS_DIRS="$SKILLS_DIRS,\"$ARCANA_HOME/skills\""
    else
      SKILLS_DIRS="\"$ARCANA_HOME/skills\""
    fi
  fi
  printf '{"$schema":"https://raw.githubusercontent.com/Lento47/arcana/master/schema/config.json","skills":{"paths":[%s]}}\n' "$SKILLS_DIRS" > "$CONFIG"
fi

export ARCANA_CONFIG="$CONFIG"
PWD="${PWD:-$(pwd)}"
export PWD

# Subcommand check — delegate to full arcana TypeScript CLI
# Keep this list in sync with packages/arcana/src/index.ts SUBCOMMANDS.
case "${1:-}" in
  run|skills|cron|memory|gateway|completion|config|learn|doctor|history|theme|feedback|web)
    exec bun run "$REPO_ROOT/packages/arcana/src/index.ts" "$@"
    ;;
esac

# TUI mode — spawn the engine directly, zero arcana overhead.
# --cwd so bun resolves JSX transpile config (jsxImportSource: @opentui/solid)
# from the engine package regardless of launch dir; exported PWD above keeps the
# app pointed at the user's project (it reads PWD, not bun's cwd).
exec bun run --cwd "$REPO_ROOT/packages/engine" --conditions=browser "$REPO_ROOT/packages/engine/src/index.ts" "$@"
