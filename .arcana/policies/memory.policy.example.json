{
  "name": "default-memory-policy",
  "version": "0.1.0",
  "default": {
    "storeSourcedFactsOnly": true,
    "storeSecrets": false,
    "requireScope": true,
    "requireConfidence": true,
    "proposeBeforeActivate": true
  },
  "scopes": {
    "session": {
      "defaultStatus": "temporary"
    },
    "repo": {
      "defaultStatus": "proposed"
    },
    "workspace": {
      "defaultStatus": "proposed",
      "requiresReview": true
    },
    "user": {
      "defaultStatus": "proposed",
      "requiresReview": true
    }
  },
  "forbiddenMemory": [
    "secrets",
    "auth_tokens",
    "private_keys",
    "passwords",
    "raw_customer_data"
  ]
}
