{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcana.otnelhq.com/schemas/assurance-manifest.v1.schema.json",
  "title": "Arcana full-platform assurance manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "projectOrganization",
    "scope",
    "candidate",
    "deployment",
    "artifacts",
    "requiredEnvironments",
    "requiredSuites"
  ],
  "properties": {
    "schemaVersion": { "const": "arcana.assurance-manifest.v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "projectOrganization": { "const": "Arcana" },
    "scope": { "const": "full_platform" },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "commit", "clean", "sourceArchiveSha256"],
      "properties": {
        "tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+-rc\\.[0-9]+$" },
        "commit": { "$ref": "#/$defs/commit" },
        "clean": { "const": true },
        "sourceArchiveSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "manifestPath", "sha256"],
      "properties": {
        "name": { "const": "hardened-linux-reference" },
        "manifestPath": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "requiredEnvironments": {
      "type": "array",
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "platform", "architecture"],
          "properties": {
            "id": { "const": "linux-x64" },
            "platform": { "const": "linux" },
            "architecture": { "const": "x64" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "platform", "architecture"],
          "properties": {
            "id": { "const": "macos-arm64" },
            "platform": { "const": "darwin" },
            "architecture": { "const": "arm64" }
          }
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "requiredSuites": {
      "type": "array",
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "command", "cwd"],
          "properties": {
            "id": { "const": "acep-1-conformance" },
            "command": { "const": ["bun", "run", "conformance", "--json", "--output", "conformance.json"] },
            "cwd": { "const": "." }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "command", "cwd", "expected"],
          "properties": {
            "id": { "const": "phase-c-adversarial" },
            "command": {
              "const": [
                "bun",
                "test",
                "packages/engine/test/capability/phase-c-wave-1.test.ts",
                "packages/engine/test/capability/phase-c-wave-2a.test.ts",
                "packages/engine/test/capability/phase-c-wave-2b.test.ts",
                "packages/engine/test/capability/phase-c-wave-3.test.ts",
                "packages/engine/test/capability/phase-c-wave-4.test.ts",
                "packages/engine/test/capability/phase-c-wave-5.test.ts",
                "packages/engine/test/capability/phase-c-gap-closure.test.ts"
              ]
            },
            "cwd": { "const": "." },
            "expected": {
              "type": "object",
              "additionalProperties": false,
              "required": ["unexpectedAllows", "protectedExecutorCallsOnDeniedPaths"],
              "properties": {
                "unexpectedAllows": { "const": 0 },
                "protectedExecutorCallsOnDeniedPaths": { "const": 0 }
              }
            }
          }
        }
      ],
      "minItems": 2,
      "maxItems": 2
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
