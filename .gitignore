# Local Obsidian knowledge vault (migrated Claude auto-memory)
.vault/

# Dependencies
node_modules/
.bun/

# Turbo cache
.turbo/cache

# Claude session lock files
.claude/scheduled_tasks.lock
.arcana/.session-lock

# Private keys / signing material
*-private.pem
arcana-signing-private.pem
*.pem
!**/public/**/*.pem

# Secrets and local credential dumps (never commit)
tmp_admin*.txt
tmp_*key*.txt
tmp_*secret*.txt
*secret*.txt
*credentials*.txt
*.key
!*.key.ts
!*.key.tsx

# Build output
dist/
dist-*/
gen/
!packages/sdk/js/src/gen/
!packages/sdk/js/src/v2/gen/
.artifacts/

# Environment
.env
.env.*
!.env.example
!.env.*.example

# Logs / local debug
*.log
*.log.*
mouse-debug.log
stdin-debug.log
tui-boot*.log

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Packages (tarballs, tgz)
*.tgz

# Temporary / Research
temporary-*.md
research/
tmp/
temp/
*.tmp
*.bak

# Cloudflare / Workers local state
.wrangler/
.dev.vars
.dev.vars.*

# Local project memory (Claude session notes, not uploaded)
.memory/

# Vendored docs library working checkout — only content/ is committed
.hermes/docs/ai-sdk/ai-main/*
!.hermes/docs/ai-sdk/ai-main/content/

# Local engine runtime state (approvals DB, session locks)
packages/engine/.arcana/approvals.db*
packages/engine/.arcana/

# Claude local worktrees / session junk
.claude/worktrees/
packages/core/src/crypto/.test-crash-recovery/
