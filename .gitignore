# Local Obsidian knowledge vault (migrated Claude auto-memory)
.vault/

# Dependencies
node_modules/
.bun/

# Turbo cache
.turbo/cache

# Claude session lock files
.claude/scheduled_tasks.lock
.arcana/

# Private keys / signing material
*-private.pem
arcana-signing-private.pem
*.pem
!**/public/**/*.pem

# Secrets and local credential dumps (never commit)
tmp_admin*.txt
tmp_*key*.txt
tmp_*secret*.txt
*secret*.txt
*credentials*.txt
*.key
!*.key.ts
!*.key.tsx

# Build output
dist/
dist-*/
gen/
!packages/sdk/js/src/gen/
!packages/sdk/js/src/v2/gen/
.artifacts/

# Environment
.env
.env.*
!.env.example
!.env.*.example

# Logs / local debug
*.log
*.log.*
mouse-debug.log
stdin-debug.log
tui-boot*.log

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Packages (tarballs, tgz)
*.tgz

# Temporary / Research
temporary-*.md
research/
tmp/
temp/
*.tmp
*.bak

# Cloudflare / Workers local state
.wrangler/
.dev.vars
.dev.vars.*

# Local project memory (Claude session notes, not uploaded)
.memory/

# Vendored docs library working checkout — only content/ is committed
.hermes/docs/ai-sdk/ai-main/*
!.hermes/docs/ai-sdk/ai-main/content/

# Local engine runtime state (approvals DB, session locks)
packages/engine/.arcana/approvals.db*
packages/engine/.arcana/

# Claude local worktrees / session junk
.claude/worktrees/
packages/core/src/crypto/.test-crash-recovery/

# Raw test evidence is committed for the completion gate.
!docs/evidence/*.log
!docs/evidence/*.log.err
# Authority dynamic-audit transient report
.authority-dynamic.json

# Bun runtime download cache (never commit binaries)
packages/engine/.bun-cache/
packages/*/.bun-cache/

# Kernel bench/probe transients
.tmp-probe*.ts
.tmp-marker.txt
.tmp-fs-probe.*
.tmp-effect-claim/
.tmp-replay-k3b/
.tmp-claim-probe.db*
.tmp-authprobe*

# Process-gate test transients
packages/core/src/capability/.tmp-process-gate/

# Capability gate runtime scratch
packages/core/src/capability/.tmp-process-gate/
